<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>12.0</LangVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Ensure RuntimeIdentifier is set, fallback to a default -->
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
	</PropertyGroup>
	<ItemGroup Condition=" '$(RuntimeIdentifier)' == 'win-x64' ">
		<!-- For windows, use the MPI.Net Nuget package -->
		<PackageReference Include="MPI.NET" Version="1.4.0" />
	</ItemGroup>
	<ItemGroup Condition=" '$(RuntimeIdentifier)' == 'linux-x64' ">
		<!-- For linux, MPI.net needs to be compiled and copied to the MassSimulation/lib directory -->
		<Reference Include="MPI" />
		<Content Include="lib/libmpinet.so">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>libmpinet.so</Link>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CalculationController\CalculationController.csproj" />
		<ProjectReference Include="..\SimulationEngineLib\SimulationEngineLib.csproj" />
	</ItemGroup>

</Project>
