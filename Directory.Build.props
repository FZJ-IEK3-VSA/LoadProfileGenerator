<Project>
  <PropertyGroup>
    <AssemblyVersion>10.10.0.5</AssemblyVersion>
    <FileVersion>10.10.0.5</FileVersion>
  </PropertyGroup>

  <!-- Defaults for all projects. Projects override these where needed (e.g. Windows target framework, Nullable). -->
  <PropertyGroup>
    <!-- Single source of truth for the .NET version. Windows-only projects use $(LpgDotnetVersion)-windows.
         CreateNewRelease.cmd and the ReleaseMaker read this value, so it only needs to be changed here. -->
    <LpgDotnetVersion>net10.0</LpgDotnetVersion>
    <TargetFramework>$(LpgDotnetVersion)</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" />
  </ItemGroup>
</Project>
